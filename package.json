{
  "name": "@aloi/adam",
  "version": "0.0.0",
  "private": true,
  "description": "Aloi Distributed Agent Memory for Pi",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "dist/",
    "docs/",
    "extension.js",
    "README.md"
  ],
  "scripts": {
    "build": "shadow-cljs release extension",
    "clean": "rm -rf dist target .shadow-cljs",
    "test": "npm run build && npm run test:cljs && node --test test/*.test.js",
    "test:cljs": "shadow-cljs compile test",
    "test:neo4j": "shadow-cljs compile neo4j-test",
    "watch": "shadow-cljs watch extension test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "shadow-cljs": "3.5.3"
  },
  "pi": {
    "extensions": [
      "./extension.js"
    ]
  },
  "dependencies": {
    "neo4j-driver": "^5.28.3"
  }
}
