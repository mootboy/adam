{
  "name": "@mootboy/adam",
  "version": "0.1.1",
  "private": true,
  "description": "A Distributed Agent Memory for Pi",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "dist/",
    "docs/",
    "extension.js",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "shadow-cljs release extension",
    "clean": "rm -rf dist target .shadow-cljs",
    "test": "npm run build && npm run test:cljs && node --test test/*.test.js",
    "test:cljs": "shadow-cljs compile test",
    "test:neo4j": "shadow-cljs compile neo4j-test",
    "watch": "shadow-cljs watch extension test",
    "check:dist": "git diff --exit-code -- dist/adam.js",
    "ci": "npm test && npm run check:dist"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "shadow-cljs": "3.5.3"
  },
  "pi": {
    "extensions": [
      "./extension.js"
    ]
  },
  "dependencies": {
    "neo4j-driver": "^6.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/mootboy/adam.git"
  },
  "homepage": "https://github.com/mootboy/adam#readme",
  "bugs": {
    "url": "https://github.com/mootboy/adam/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
