{:source-paths ["src" "test/cljs"]
 :dependencies [[org.clojure/test.check "1.1.1"]]
 ;; Parallel macro compilation can change gensyms/capture order in committed artifacts.
 ;; Serialize ESM compilation; test targets need no reproducible packaged output.
 :builds
 {:extension
  {:compiler-options {:parallel-build false}
   :target :esm
   :output-dir "dist"
   :js-options {:js-provider :import}
   :modules
   {:adam
    {:entries [adam.extension]
     :exports {start adam.extension/start}}}}

  :mcp
  {:compiler-options {:parallel-build false}
   :target :esm
   :output-dir "dist"
   :js-options {:js-provider :import}
   :modules
   {:adam-mcp
    {:entries [adam.mcp]
     :exports {start adam.mcp/start}}}}

  :hook
  {:compiler-options {:parallel-build false}
   :target :esm
   :output-dir "dist"
   :js-options {:js-provider :import}
   :modules
   {:adam-hook
    {:entries [adam.sources.claude-code.hook]
     :exports {start adam.sources.claude-code.hook/start}}}}

  :worker
  {:compiler-options {:parallel-build false}
   :target :esm
   :output-dir "dist"
   :js-options {:js-provider :import}
   :modules
   {:adam-worker
    {:entries [adam.worker]
     :exports {start adam.worker/start}}}}

  :test
  {:target :node-test
   :output-to "target/tests.cjs"
   :main adam.test-runner/main
   :ns-regexp "(?<!live)-test$"
   :autorun false}

  :test-exit-probe
  {:target :node-test
   :output-to "target/test-exit-probe.cjs"
   :main adam.test-runner/main
   :ns-regexp "^adam\\.test-exit-probe$"
   :autorun false}

  :neo4j-test
  {:compiler-options {:closure-defines {adam.test-runner/DEFAULT_TIMEOUT_MS 600000}}
   :target :node-test
   :output-to "target/neo4j-tests.cjs"
   :main adam.test-runner/main
   :ns-regexp "-live-test$"
   :autorun false}}}
