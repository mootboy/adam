{:source-paths ["src" "test/cljs"]
 :builds
 {:extension
  {:target :esm
   :output-dir "dist"
   :modules
   {:adam
    {:entries [adam.extension]
     :exports {start adam.extension/start}}}}

  :test
  {:target :node-test
   :output-to "target/tests.cjs"
   :ns-regexp "-test$"
   :autorun true}}}
